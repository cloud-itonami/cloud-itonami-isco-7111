;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a job-site scheduling/logistics coordination robot
;; performs crew scheduling, materials-usage/progress-record logging and
;; building-materials supply-order coordination for house builders
;; (ISCO 7111). It never performs construction work or decides structural
;; work. Its physical work is materials logistics: moving delivered material
;; bundles across the rough site to the work face, handing a bundle up to the
;; staging deck, and a receiving check of a delivered rebar sample under a
;; proof load (the check is recorded; any structural decision stays with the
;; foreman).
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-7111"
 :cases
 [{:id :materials-bundle-to-work-face
   :kind :transport
   :procedure "logistics robot moves a delivered bundle of building materials 50 m across a compacted-gravel site to the work face"
   :params {:mass-kg 200.0 :distance-m 50.0 :v-max-mps 0.8 :a-max-mps2 0.25
            :brake-decel-mps2 0.5 :drive-force-n 600.0 :crr 0.05
            :cog-height-m 0.60 :support-half-length-m 0.50}
   :sweep {:param :payload-kg :values [100.0 200.0 400.0 600.0 800.0]}
   :quantity :cycle-time-s
   :limit {:max 150.0 :basis "estimate: a bundle must reach the work face within ~2.5 minutes of the crew's call so framing does not stall"}
   :boundary {:lo 20.0 :hi 1200.0}}
  {:id :bundle-to-staging-deck
   :kind :manipulator
   :procedure "arm hands a small bundle of fixings or sheathing offcuts from the robot deck up to the staging deck"
   :params {:l1-m 0.70 :l2-m 0.60 :m1-kg 10.0 :m2-kg 7.0
            :from [0.80 0.10] :to [0.40 1.10] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [2.0 5.0 10.0 15.0 20.0]}
   :quantity :peak-tau1-nm
   :limit {:max 200.0 :basis "estimate: continuous shoulder torque of a ~20 kg payload class arm"}
   :boundary {:lo 0.5 :hi 50.0}}
  {:id :rebar-sample-proof-load
   :kind :material
   :procedure "receiving check: a 100 mm length of delivered D10 deformed bar (SD295, 71.33 mm2) pulled to a proof load; strain at the proof load is recorded"
   :params {:length-m 0.10 :area-m2 7.133e-5 :youngs-modulus-pa 205.0e9 :yield-stress-pa 295.0e6
            :hardening-pa 2.0e9 :density-kg-m3 7850.0}
   :sweep {:param :max-force-n :values [8000.0 12000.0 16000.0 20000.0 24000.0]}
   :quantity :final-strain
   :limit {:max 0.002 :basis "estimate: a receiving proof load should stay elastic; 0.2 % strain is taken as the working ceiling (the yield-stress parameter is the JIS G 3112 SD295 minimum yield point, 295 N/mm2)"}
   :boundary {:lo 5000.0 :hi 30000.0}}]}
